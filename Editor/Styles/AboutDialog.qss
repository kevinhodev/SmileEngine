QDialog#AboutDialog {
    background: #080909;
}

QDialog#AboutDialog QLabel {
    color: #ddd8ca;
}

QDialog#AboutDialog QTabWidget::pane {
    background: #10110f;
    border: 1px solid #292a24;
    border-top: 2px solid #d9a514;
}

QDialog#AboutDialog QTabBar::tab {
    background: #181916;
    color: #9a958a;
    padding: 7px 18px;
    border: 1px solid #292a24;
    border-bottom: none;
    margin-right: 2px;
}

QDialog#AboutDialog QTabBar::tab:selected {
    background: #30230d;
    color: #ffd35d;
}

QDialog#AboutDialog QTabBar::tab:hover:!selected {
    background: #202018;
    color: #ddd8ca;
}

QDialog#AboutDialog QTextBrowser {
    background: #10110f;
    color: #ddd8ca;
    border: none;
    padding: 14px;
    selection-background-color: #d9a514;
    selection-color: #0a0a09;
}

QDialog#AboutDialog QPushButton {
    background: #181916;
    color: #ddd8ca;
    padding: 7px 22px;
    border: 1px solid #292a24;
    border-radius: 5px;
    min-width: 80px;
}

QDialog#AboutDialog QPushButton:hover {
    background: #30230d;
    border-color: #d9a514;
    color: #ffd35d;
}

QDialog#AboutDialog QPushButton:pressed {
    background: #7a5305;
    border-color: #d9a514;
}

QFrame#AboutAccentStrip {
    background: #d9a514;
}

QWidget#AboutHeader {
    background: #10110f;
    border-bottom: 1px solid #292a24;
}

QLabel#AboutLogo {
    background: transparent;
    border: none;
}

QLabel#AboutTitle {
    color: #f1eadc;
    font-size: 24px;
    font-weight: 600;
}

QLabel#AboutSubtitle {
    color: #d9a514;
    font-size: 11px;
}

QLabel#AboutVersion {
    color: #9a958a;
    font-family: "Consolas", "Cascadia Mono", monospace;
    font-size: 10px;
}
