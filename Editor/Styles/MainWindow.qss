/* O viewport fica sobre o fundo dos gutters (#121212), sem moldura e sem raio: a toolbar em
   cima e os fios escuros dos docks ja delimitam a area de render. */
QFrame#ViewportPanel {
    background: #121212;
    border: none;
}

QWidget#MainViewport {
    background: #121212;
}

QWidget#ConsolePanel {
    background: #212121;
}
