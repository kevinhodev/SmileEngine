/* O viewport e a superficie mais escura do conceito (#09090A), sem moldura e sem raio: a
   toolbar em cima e as hairlines dos docks ja delimitam a area de render. */
QFrame#ViewportPanel {
    background: #09090A;
    border: none;
}

QWidget#MainViewport {
    background: #09090A;
}

QWidget#ConsolePanel {
    background: #111113;
}
