QLabel#MaterialHeader {
    background: #10110f;
    color: #d9a514;
    font-weight: 600;
    font-size: 12px;
    padding: 9px 10px;
    border-bottom: 1px solid #292a24;
}

QScrollArea#MaterialScrollArea {
    background: #10110f;
    border: none;
}

QGroupBox#MaterialTexturesGroup,
QGroupBox#MaterialParametersGroup {
    background: #121310;
    color: #d9a514;
    font-size: 11px;
    font-weight: 600;
    border: 1px solid #292a24;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 10px;
}

QGroupBox#MaterialTexturesGroup::title,
QGroupBox#MaterialParametersGroup::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    background: #10110f;
    color: #d9a514;
}

QLabel#MaterialParamLabel {
    color: #a9a396;
    font-size: 10px;
}

QDoubleSpinBox#MaterialSpinBox {
    background: #181916;
    color: #e5dfd2;
    border: 1px solid #2a2b26;
    border-radius: 4px;
    padding: 3px 6px;
    font-size: 10px;
}

QDoubleSpinBox#MaterialSpinBox:focus {
    border-color: #d49a11;
}

QPushButton#MaterialColorBtn {
    border: 1px solid #3b3b33;
    border-radius: 4px;
    min-height: 22px;
}

QPushButton#MaterialColorBtn:hover {
    border-color: #d49a11;
}

QCheckBox#MaterialDirectXCheck {
    color: #aaa497;
    font-size: 10px;
}

QFrame#MaterialSeparator {
    color: #292a24;
    background: #292a24;
    max-height: 1px;
}
