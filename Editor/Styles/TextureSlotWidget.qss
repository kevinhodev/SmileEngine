SmileEditor--TextureSlotWidget,
QWidget#TextureSlotWidget {
    background: #171814;
    border: 1px solid #292a24;
    border-radius: 6px;
}

SmileEditor--TextureSlotWidget:hover,
QWidget#TextureSlotWidget:hover {
    background: #1d1d18;
    border-color: #4b3a16;
}

QLabel#SlotThumbnail {
    border: 1px solid #303129;
    border-radius: 4px;
    background: #0d0e0c;
}

QLabel#SlotNameLabel {
    color: #e6dfd0;
    font-weight: 600;
    font-size: 11px;
    border: none;
    background: transparent;
}

QLabel#SlotPathLabel {
    color: #8d887e;
    font-size: 10px;
    border: none;
    background: transparent;
}

QPushButton#SlotBrowseBtn {
    background: #202018;
    color: #d8d3c5;
    border: 1px solid #303027;
    border-radius: 4px;
    font-size: 10px;
    padding: 0 8px;
}

QPushButton#SlotBrowseBtn:hover {
    background: #2d2512;
    border-color: #b47e0d;
    color: #ffd35d;
}

QPushButton#SlotBrowseBtn:pressed {
    background: #3a2b10;
}

QPushButton#SlotClearBtn {
    background: #202018;
    color: #a9a396;
    border: 1px solid #303027;
    border-radius: 4px;
    font-size: 11px;
    padding: 0;
}

QPushButton#SlotClearBtn:hover {
    background: #4c1d18;
    border-color: #ff5f57;
    color: #fff1ed;
}
