/* Widgets Qt do editor no conceito "Cartao 18%" (Docs/Design/EditorRedesign/cartao-18.md).
   O grosso da UI e QML e le os tokens de Qml/components/Theme.qml; este arquivo cobre o
   que ainda e widget nativo — separadores de dock, scroll areas, dialogos de arquivo.
   Os hex aqui repetem os do Theme de proposito: QSS nao le o singleton QML. */
* {
    font-family: "Archivo Smile", "Segoe UI", "Arial";
    font-size: 12px;
    color: #D4D4D4;
    selection-background-color: #F4C430;
    selection-color: #1E1E1E;
}

QMainWindow#SmileMainWindow {
    background: #121212;
}

QStatusBar#EditorStatusBar {
    background: #1A1A1A;
    border: none;
    margin: 0;
    padding: 0;
}

QStatusBar#EditorStatusBar::item {
    border: none;
}

QWidget {
    background: transparent;
}

QToolTip {
    color: #EDEDED;
    background-color: #171717;
    border: 1px solid #0F0F0F;
    border-radius: 4px;
    padding: 6px 8px;
}

QMenu {
    background: #171717;
    color: #D4D4D4;
    border: 1px solid #0F0F0F;
    padding: 6px;
}

QMenu::item {
    border-radius: 3px;
    padding: 7px 28px 7px 12px;
}

QMenu::item:selected {
    background: #2E2E2E;
    color: #EDEDED;
}

QMenu::item:disabled {
    color: #595959;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
}

/* O separador E o fio escuro entre paineis (hairlineStrong): no conceito os paineis encostam
   e a divisa e um sulco, nao uma faixa. 2 px para o cursor de resize ter onde pegar; o hover
   acende no accent porque arrastar e uma acao. */
QMainWindow::separator {
    background: #0F0F0F;
    width: 2px;
    height: 2px;
}

QMainWindow::separator:hover {
    background: #F4C430;
}

/* Docks nao tem moldura nem raio: cada painel QML fecha a propria borda com hairline, e uma
   segunda borda aqui viraria fio duplo. A title bar nativa e substituida por um widget de
   altura zero no MainWindow. */
QDockWidget {
    background: #212121;
    color: #EDEDED;
    border: none;
}

QAbstractScrollArea,
QScrollArea {
    background: #212121;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 9px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #3C3C3C;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #8C8C8C;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0;
}

QGroupBox {
    background: #171717;
    color: #BDBDBD;
    font-weight: 600;
    border: 1px solid #0F0F0F;
    border-radius: 4px;
    margin-top: 14px;
    padding-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 5px;
    color: #BDBDBD;
    background: #212121;
}

QLabel {
    color: #D4D4D4;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QDoubleSpinBox,
QSpinBox,
QComboBox {
    background: #171717;
    color: #EDEDED;
    border: 1px solid #0F0F0F;
    border-radius: 3px;
    padding: 4px 7px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QDoubleSpinBox:focus,
QSpinBox:focus,
QComboBox:focus {
    border-color: #F4C430;
    background: #2E2E2E;
}

QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button,
QSpinBox::up-button,
QSpinBox::down-button {
    width: 0;
    border: none;
}

QPushButton,
QToolButton {
    background: #171717;
    color: #D4D4D4;
    border: 1px solid #0F0F0F;
    border-radius: 3px;
    padding: 5px 10px;
}

QPushButton:hover,
QToolButton:hover {
    background: #2E2E2E;
    border-color: #0F0F0F;
    color: #EDEDED;
}

QPushButton:pressed,
QToolButton:pressed,
QToolButton:checked {
    background: #3C3C3C;
    border-color: #0F0F0F;
    color: #EDEDED;
}

QCheckBox {
    color: #BDBDBD;
    spacing: 7px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #0F0F0F;
    border-radius: 2px;
    background: #171717;
}

QCheckBox::indicator:hover {
    border-color: #8C8C8C;
}

QCheckBox::indicator:checked {
    background: #D9D9D9;
    border-color: #D9D9D9;
}
