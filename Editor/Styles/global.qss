/* Widgets Qt do editor no conceito "Signal Graphite" (Docs/Design/EditorRedesign).
   O grosso da UI e QML e le os tokens de Qml/components/Theme.qml; este arquivo cobre o
   que ainda e widget nativo — separadores de dock, scroll areas, dialogos de arquivo.
   Os hex aqui repetem os do Theme de proposito: QSS nao le o singleton QML. */
* {
    font-family: "Inter", "Segoe UI", "Arial";
    font-size: 12px;
    color: #C9C9CF;
    selection-background-color: #FF6B2C;
    selection-color: #09090A;
}

QMainWindow#SmileMainWindow {
    background: #09090A;
}

QStatusBar#EditorStatusBar {
    background: #111113;
    border: none;
    margin: 0;
    padding: 0;
}

QStatusBar#EditorStatusBar::item {
    border: none;
}

QWidget {
    background: transparent;
}

QToolTip {
    color: #F2F2F0;
    background-color: #18181B;
    border: 1px solid #333338;
    border-radius: 4px;
    padding: 6px 8px;
}

QMenu {
    background: #18181B;
    color: #C9C9CF;
    border: 1px solid #333338;
    padding: 6px;
}

QMenu::item {
    border-radius: 3px;
    padding: 7px 28px 7px 12px;
}

QMenu::item:selected {
    background: #1F1F23;
    color: #F2F2F0;
}

QMenu::item:disabled {
    color: #5F5F66;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
}

/* O separador fica na cor do shell, invisivel: quem desenha a divisa e a hairline de 1 px
   na borda de cada painel QML (a mesma linha que o conceito usa como elemento de identidade).
   Pintar a faixa inteira de #26262B daria um fio de 3 px, grosso demais ao lado dela.
   A largura existe so para o cursor de resize ter onde pegar; o hover acende no accent
   porque arrastar e uma acao. */
QMainWindow::separator {
    background: #111113;
    width: 3px;
    height: 3px;
}

QMainWindow::separator:hover {
    background: #FF6B2C;
}

/* Docks nao tem moldura nem raio: cada painel QML fecha a propria borda com hairline, e uma
   segunda borda aqui viraria fio duplo. A title bar nativa e substituida por um widget de
   altura zero no MainWindow. */
QDockWidget {
    background: #111113;
    color: #F2F2F0;
    border: none;
}

QAbstractScrollArea,
QScrollArea {
    background: #111113;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 9px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #333338;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #5F5F66;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0;
}

QGroupBox {
    background: #18181B;
    color: #A0A0A8;
    font-weight: 600;
    border: 1px solid #26262B;
    border-radius: 4px;
    margin-top: 14px;
    padding-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 5px;
    color: #A0A0A8;
    background: #111113;
}

QLabel {
    color: #C9C9CF;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QDoubleSpinBox,
QSpinBox,
QComboBox {
    background: #18181B;
    color: #F2F2F0;
    border: 1px solid #26262B;
    border-radius: 3px;
    padding: 4px 7px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QDoubleSpinBox:focus,
QSpinBox:focus,
QComboBox:focus {
    border-color: #FF6B2C;
    background: #1F1F23;
}

QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button,
QSpinBox::up-button,
QSpinBox::down-button {
    width: 0;
    border: none;
}

QPushButton,
QToolButton {
    background: #18181B;
    color: #C9C9CF;
    border: 1px solid #26262B;
    border-radius: 3px;
    padding: 5px 10px;
}

QPushButton:hover,
QToolButton:hover {
    background: #1F1F23;
    border-color: #333338;
    color: #F2F2F0;
}

QPushButton:pressed,
QToolButton:pressed,
QToolButton:checked {
    background: rgba(255, 107, 44, 0.12);
    border-color: rgba(255, 107, 44, 0.45);
    color: #FF6B2C;
}

QCheckBox {
    color: #A0A0A8;
    spacing: 7px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #333338;
    border-radius: 2px;
    background: #18181B;
}

QCheckBox::indicator:hover {
    border-color: #5F5F66;
}

QCheckBox::indicator:checked {
    background: #FF6B2C;
    border-color: #FF6B2C;
}
