{
  "name": "smile-mcp",
  "version": "0.4.0",
  "private": true,
  "description": "Servidor MCP local para inspecionar, compilar e executar a SmileEngine.",
  "type": "module",
  "bin": {
    "smile-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:capture": "npm run build && node scripts/capture-smoke.mjs",
    "validate:gi": "npm run build && node scripts/gi-validation.mjs",
    "validate:gi:adaptive-visual": "npm run build && node scripts/gi-adaptive-visual.mjs",
    "validate:gi:interleaved": "npm run build && node scripts/gi-interleaved.mjs",
    "analyze:gi:interleaved": "python scripts/compare-gi-interleaved.py",
    "benchmark:gi": "npm run build && node scripts/gi-benchmark.mjs",
    "benchmark:gi:adaptive": "npm run build && node scripts/gi-benchmark.mjs --suite adaptive"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  }
}
