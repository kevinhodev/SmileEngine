{
  "name": "smile-mcp",
  "version": "0.4.0",
  "private": true,
  "description": "Servidor MCP local para inspecionar, compilar e executar a SmileEngine.",
  "type": "module",
  "bin": {
    "smile-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:capture": "npm run build && node scripts/capture-smoke.mjs",
    "validate:reflections:transitions": "npm run build && node scripts/reflection-transition-smoke.mjs",
    "validate:dlss": "npm run build && node scripts/dlss-validation.mjs",
    "validate:dlss-noise": "npm run build && node scripts/dlss-noise-ab.mjs",
    "validate:dlss-rain": "npm run build && node scripts/dlss-rain-validation.mjs",
    "validate:gi": "npm run build && node scripts/gi-validation.mjs",
    "validate:gi:adaptive-visual": "npm run build && node scripts/gi-adaptive-visual.mjs",
    "validate:gi:interleaved": "npm run build && node scripts/gi-interleaved.mjs",
    "analyze:gi:interleaved": "python scripts/compare-gi-interleaved.py",
    "validate:gi:probe-compaction": "npm run build && node scripts/gi-probe-compaction.mjs",
    "validate:gi:update-budget": "npm run build && node scripts/gi-update-budget.mjs",
    "validate:gi:update-budget:full": "npm run build && node scripts/gi-update-budget-validation.mjs",
    "validate:gi:update-budget:emerald": "npm run build && node scripts/gi-update-budget-validation.mjs --scene Assets/Scenes/EmeraldSquare_v4_1/EmeraldSquare_Day.sscene",
    "validate:gi:cascade-scroll": "npm run build && node scripts/gi-cascade-scroll-validation.mjs",
    "validate:gi:cascade-scroll:reference": "npm run build && node scripts/gi-cascade-scroll-validation.mjs --reference-view",
    "validate:gi:cascade-scroll:bush": "npm run build && node scripts/gi-cascade-scroll-validation.mjs --opposite-view",
    "validate:gi:cascade-scroll:emerald": "npm run build && node scripts/gi-cascade-scroll-validation.mjs --scene Assets/Scenes/EmeraldSquare_v4_1/EmeraldSquare_Day.sscene",
    "analyze:gi:cascade-scroll": "python scripts/compare-gi-cascade-scroll.py",
    "smoke:gi:probe-compaction-default": "npm run build && node scripts/gi-probe-compaction.mjs --startup-smoke",
    "analyze:gi:probe-compaction": "python scripts/compare-gi-probe-compaction.py",
    "validate:gi:half-res": "npm run build && node scripts/gi-half-res.mjs",
    "validate:gi:half-res:rr": "npm run build && node scripts/gi-half-res.mjs --gameplay-rr",
    "validate:gi:half-res:motion": "npm run build && node scripts/gi-half-res-motion.mjs",
    "smoke:gi:half-res": "npm run build && node scripts/gi-half-res.mjs --startup-smoke",
    "analyze:gi:half-res": "python scripts/compare-gi-half-res.py",
    "analyze:gi:half-res:motion": "python scripts/compare-gi-half-res-motion.py",
    "benchmark:gi": "npm run build && node scripts/gi-benchmark.mjs",
    "benchmark:gi:adaptive": "npm run build && node scripts/gi-benchmark.mjs --suite adaptive",
    "benchmark:gpu-driven": "npm run build && node scripts/gpu-driven-baseline.mjs",
    "benchmark:gpu-driven:smoke": "npm run build && node scripts/gpu-driven-baseline.mjs --scenes synthetic_10k --warmup 3 --samples 8 --interval 150"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  }
}
